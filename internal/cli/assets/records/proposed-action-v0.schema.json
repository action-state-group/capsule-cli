{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentactioncapsule.org/records/proposed-action-v0.schema.json",
  "title": "proposed-action/v0",
  "description": "The normalized ProposedAction exactly as checked. Its record digest is the evaluation's proposed_action_digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "canonicalization",
    "chain_id",
    "seq",
    "at",
    "prev",
    "chain_root",
    "body"
  ],
  "properties": {
    "type": {
      "const": "proposed-action/v0"
    },
    "canonicalization": {
      "const": "jcs"
    },
    "chain_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,15}-[0-9a-f]{16,64}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "at": {
      "$ref": "record-common-v0.schema.json#/$defs/when"
    },
    "prev": {
      "$ref": "record-common-v0.schema.json#/$defs/ref"
    },
    "chain_root": {
      "$ref": "record-common-v0.schema.json#/$defs/ref"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "record-common-v0.schema.json#/$defs/rel_ref"
      }
    },
    "producer": {
      "$ref": "record-common-v0.schema.json#/$defs/producer"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "dependentRequired": {
        "action_class": [
          "taxonomy_version"
        ],
        "taxonomy_version": [
          "action_class"
        ]
      },
      "properties": {
        "action": {
          "$ref": "record-common-v0.schema.json#/$defs/action"
        },
        "action_class": {
          "$ref": "record-common-v0.schema.json#/$defs/action_class"
        },
        "taxonomy_version": {
          "$ref": "record-common-v0.schema.json#/$defs/taxonomy_version"
        },
        "spend_minor": {
          "$ref": "record-common-v0.schema.json#/$defs/uint"
        },
        "authorized_max_minor": {
          "description": "On a pay: the most the counterparty may take under the payment's authorization, at least amount_minor (the expected charge). A limit binds it.",
          "$ref": "record-common-v0.schema.json#/$defs/uint"
        },
        "spend_authorized_minor": {
          "description": "The authorized maximum beside spend_minor: what a per-action spend cap reads.",
          "$ref": "record-common-v0.schema.json#/$defs/uint"
        },
        "fee_minor": {
          "$ref": "record-common-v0.schema.json#/$defs/uint"
        },
        "cancelled_amount_minor": {
          "$ref": "record-common-v0.schema.json#/$defs/uint"
        },
        "direction": {
          "enum": [
            "in"
          ]
        },
        "amount_minor": {
          "$ref": "record-common-v0.schema.json#/$defs/uint"
        },
        "currency": {
          "$ref": "record-common-v0.schema.json#/$defs/currency"
        },
        "seen_item": {
          "type": "boolean"
        },
        "disclosing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disclosing_to": {
          "enum": [
            "counterparty",
            "other"
          ]
        },
        "terms": {
          "type": "object"
        },
        "recourse": {
          "type": "object"
        },
        "description_commitment": {
          "$ref": "record-common-v0.schema.json#/$defs/hex64"
        },
        "counterparty": {
          "$ref": "record-common-v0.schema.json#/$defs/counterparty"
        }
      }
    }
  }
}
