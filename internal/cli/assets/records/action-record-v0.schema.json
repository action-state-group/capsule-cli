{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentactioncapsule.org/records/action-record-v0.schema.json",
  "title": "action-record/v0",
  "description": "An action taken (the executed phase): what was done, the evaluation it relied on (evaluation_ref) and every authority layer it relied on, in order (authority_basis). refs: exactly one authorized_by -> the action-approval/v0 that answered an ASK, or the action-evaluation/v0 itself on a DO; optional reverses -> the action-record/v0 of the payment it returns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "canonicalization",
    "chain_id",
    "seq",
    "at",
    "prev",
    "chain_root",
    "refs",
    "body"
  ],
  "properties": {
    "type": {
      "const": "action-record/v0"
    },
    "canonicalization": {
      "const": "jcs"
    },
    "chain_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,15}-[0-9a-f]{16,64}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "at": {
      "$ref": "record-common-v0.schema.json#/$defs/when"
    },
    "prev": {
      "$ref": "record-common-v0.schema.json#/$defs/ref"
    },
    "chain_root": {
      "$ref": "record-common-v0.schema.json#/$defs/ref"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "record-common-v0.schema.json#/$defs/rel_ref"
      }
    },
    "producer": {
      "$ref": "record-common-v0.schema.json#/$defs/producer"
    },
    "commit_alg": {
      "$ref": "record-common-v0.schema.json#/$defs/commit_alg"
    },
    "body": {
      "allOf": [
        {
          "$ref": "record-common-v0.schema.json#/$defs/action_body"
        },
        {
          "required": [
            "evaluation_ref",
            "authority_basis"
          ],
          "properties": {
            "evaluation_ref": {
              "$ref": "record-common-v0.schema.json#/$defs/ref"
            },
            "authority_basis": {
              "$ref": "record-common-v0.schema.json#/$defs/authority_basis"
            },
            "action": true,
            "action_class": true,
            "taxonomy_version": true,
            "spend_minor": true,
            "fee_minor": true,
            "cancelled_amount_minor": true,
            "amount_minor": true,
            "currency": true,
            "rail": true,
            "direction": true,
            "reference_commitment": true,
            "description_commitment": true,
            "disclosed": true,
            "channel": true,
            "counterparty": true
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
