{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentactioncapsule.org/profiles/x-deal-v0/record.schema.json",
  "title": "x-deal-v0 deal record",
  "description": "One sealed step of a deal: the x-deal-v0 extension block plus a body whose shape is fixed by record_type. Digest input is SHA-256 over the RFC 8785 (JCS) bytes of the whole record. Structural rules only; the sequence, reference and authorization rules in PROFILE.md section 6 are checked by check_profile.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["x-deal-v0", "body"],
  "properties": {
    "x-deal-v0": { "$ref": "#/$defs/block" },
    "body": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "baseline" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_baseline" }, "x-deal-v0": { "required": ["channel", "counterparty"], "not": { "anyOf": [ { "required": ["baseline_ref"] }, { "required": ["prev"] } ] } } } },
      "else": { "properties": { "x-deal-v0": { "required": ["baseline_ref", "prev"] } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "intent" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_intent" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "message" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_message" }, "x-deal-v0": { "required": ["channel"] } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "claim" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_claim" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "evidence" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_evidence" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "detail_change" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_detail_change" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "check" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_check" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "verdict" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_verdict" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "approval" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_approval" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "action" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_action" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "outcome" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_outcome" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "close" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_close" } } } },
    { "if": { "properties": { "x-deal-v0": { "properties": { "record_type": { "const": "disclosure" } } } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/body_disclosure" } } } }
  ],
  "$defs": {
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safe_uint": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "token": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "action_class": { "description": "The action's class in the action taxonomy taxonomy_version names (version 2: capsule-engine's capsule_engine/guards/action_taxonomy.json, github.com/action-state-group/capsule-engine at 2521ee6). Absent on records sealed before it was recorded.", "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$" },
    "taxonomy_version": { "description": "The version of the action taxonomy action_class is drawn from.", "type": "string", "pattern": "^[1-9][0-9]{0,3}$" },
    "ns_token": {
      "description": "A seeded bare token, or a namespaced one (reverse-DNS prefix, e.g. org.example.foo).",
      "type": "string", "pattern": "^([a-z][a-z0-9_]{0,63}|[a-z0-9-]+(\\.[a-z0-9-]+)+\\.[a-z][a-z0-9_]{0,63})$"
    },
    "short_text": { "type": "string", "minLength": 1, "maxLength": 200 },
    "record_type": {
      "enum": ["intent", "baseline", "message", "claim", "evidence", "detail_change", "check", "verdict", "approval", "action", "outcome", "close", "disclosure"]
    },
    "point_of_no_return": { "enum": ["pay", "sign", "commit", "cancel", "share_contact", "share_credentials"] },
    "outcome_value": { "description": "completed, mismatch or open; or not_selected: the other side was not chosen, and nothing was done on the deal (no action is on record). Every value but open is final at a close.", "enum": ["completed", "mismatch", "open", "not_selected"] },
    "identifier_kind": { "enum": ["payee", "name", "domain", "phone", "email", "relay_address", "profile_id"] },
    "channel": {
      "description": "Seeded: marketplace, web, sms, phone_call, email, app_chat, whatsapp, telegram, signal, in_person, other. Anything else MUST be namespaced.",
      "anyOf": [
        { "enum": ["marketplace", "web", "sms", "phone_call", "email", "app_chat", "whatsapp", "telegram", "signal", "in_person", "other"] },
        { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+\\.[a-z][a-z0-9_]{0,63}$" }
      ]
    },
    "digest_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "digest_alg", "digest"],
      "properties": {
        "type": { "const": "deal-record" },
        "digest_alg": { "const": "SHA-256" },
        "digest": { "$ref": "#/$defs/hex64" }
      }
    },
    "rel_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["rel", "type", "digest_alg", "digest"],
      "properties": {
        "rel": { "enum": ["about", "source", "checks", "approves", "authorized_by", "observes", "outcome", "confirms", "reverses"] },
        "type": { "const": "deal-record" },
        "digest_alg": { "const": "SHA-256" },
        "digest": { "$ref": "#/$defs/hex64" }
      }
    },
    "counterparty": {
      "type": "object", "additionalProperties": false,
      "required": ["fp_alg", "ids"],
      "properties": {
        "fp_alg": { "const": "hmac-sha256-deal-key" },
        "ids": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier_kind" },
          "additionalProperties": { "$ref": "#/$defs/hex64" }
        }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "canonicalization", "deal_id", "record_type", "seq", "at"],
      "properties": {
        "profile": { "const": "x-deal-v0" },
        "canonicalization": { "const": "jcs" },
        "deal_id": { "type": "string", "pattern": "^deal-[0-9a-f]{16,64}$" },
        "record_type": { "$ref": "#/$defs/record_type" },
        "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "prev": { "$ref": "#/$defs/digest_ref" },
        "baseline_ref": { "$ref": "#/$defs/digest_ref" },
        "channel": { "$ref": "#/$defs/channel" },
        "counterparty": { "$ref": "#/$defs/counterparty" },
        "refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rel_ref" } },
        "producer": {
          "description": "The software build that sealed this record. Absent on records sealed before it was recorded.",
          "type": "object", "required": ["name", "version", "commit"], "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "commit": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "commit_alg": {
          "description": "The construction of this record's *_commitment values: SHA-256 over the RFC 8785 (JCS) bytes of {\"nonce\": N, \"text\": T}, N a fresh random 256-bit nonce (64 lowercase hex) per commitment, no key. Recomputable only by a holder of the opening (N and T). Absent on records sealed before it was declared.",
          "const": "sha256-jcs-nonce256"
        }
      }
    },
    "terms": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "item": { "$ref": "#/$defs/short_text" },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "price_minor": { "$ref": "#/$defs/safe_uint" },
        "deposit_minor": { "$ref": "#/$defs/safe_uint" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "when": { "type": "string", "minLength": 1, "maxLength": 64 },
        "place": { "type": "string", "minLength": 1, "maxLength": 80 },
        "conditions": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 200 }, "propertyNames": { "$ref": "#/$defs/token" } }
      }
    },
    "recourse": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "rail": { "$ref": "#/$defs/ns_token" },
        "refundable": { "type": "boolean" }
      }
    },
    "counterparty_facts": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": { "domain_age_days": { "$ref": "#/$defs/safe_uint" } }
    },
    "claim": {"description": "A claim: in the clear as {text, source} on a step sealed before claims were committed; from then on its words (text_commitment) and its source note (source_ref_commitment, when given) are salted commitments, and only whose it is (source_kind) is in the clear.", "oneOf": [{"type": "object", "additionalProperties": false, "required": ["text", "source"], "properties": {"text": {"$ref": "#/$defs/short_text"}, "source": {"$ref": "#/$defs/ns_token"}}}, {"type": "object", "additionalProperties": false, "required": ["text_commitment", "source_kind"], "properties": {"text_commitment": {"$ref": "#/$defs/hex64"}, "source_kind": {"enum": ["merchant", "agent", "platform", "user", "external"]}, "source_ref_commitment": {"$ref": "#/$defs/hex64"}}}]},
    "difference": {
      "type": "object", "additionalProperties": false, "required": ["question", "rule"],
      "properties": {
        "question": { "enum": ["asked", "who", "terms", "recourse", "safety", "delivered"] },
        "rule": { "$ref": "#/$defs/ns_token" },
        "field": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)?$" }
      }
    },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/[0-9]+\\.[0-9]+\\.[0-9]+$" },

    "materiality_ref": {
      "description": "A materiality predicate: its digest (SHA-256 of its JCS bytes), or none when none was configured and every pick of the agent's pauses; and label_commitment, a commitment to its name and version (the user's own policy: opened only in the user's own copy). A verdict sealed before the name and version were committed carries them in the clear instead.",
      "type": "object", "additionalProperties": false, "required": ["digest"],
      "properties": {
        "digest": { "type": "string", "pattern": "^([0-9a-f]{64}|none)$" },
        "label_commitment": { "$ref": "#/$defs/hex64" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "dependentRequired": { "name": ["version"], "version": ["name"] },
      "not": { "required": ["label_commitment", "name"] }
    },

    "body_baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["deal_type", "intent", "terms", "recourse"],
      "properties": {
        "deal_type": { "enum": ["purchase", "rental", "booking", "service"] },
        "materiality": { "$ref": "#/$defs/materiality_ref", "description": "The materiality predicate the profile pinned when the deal opened; a later verdict under another one carries a materiality_changed difference. Absent on baselines sealed before it was recorded." },
        "demo": { "type": "boolean" },
        "intent": { "$ref": "#/$defs/body_intent" },
        "terms": { "$ref": "#/$defs/terms" },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "recourse": { "type": "object", "allOf": [ { "$ref": "#/$defs/recourse" } ], "required": ["rail", "refundable"] },
        "counterparty_facts": { "$ref": "#/$defs/counterparty_facts" },
        "skill": {
          "description": "The skill instructions present when the deal opened, as the agent reported them: the SHA-256 of its SKILL.md, and how many other copies of the same skill were beside it. A boundary marker, not proof they were followed.",
          "type": "object", "additionalProperties": false, "required": ["skill_md_digest", "other_copies"],
          "properties": {
            "skill_md_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "other_copies": { "type": "integer", "minimum": 0 }
          }
        },
        "expect_close_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "body_intent": {
      "type": "object", "additionalProperties": false,
      "required": ["verbatim_commitment"],
      "properties": {
        "verbatim_commitment": { "$ref": "#/$defs/hex64" },
        "party_role": { "description": "Which side of the deal the user is on. Absent means buyer (every deal sealed before it was recorded); set when the deal opens and the same on every later intent.", "enum": ["buyer", "seller"] },
        "asked": { "$ref": "#/$defs/terms" },
        "max_total_minor": { "$ref": "#/$defs/safe_uint" },
        "allowed": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/point_of_no_return" } }
      }
    },
    "body_message": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "content_commitment"],
      "properties": {
        "from": { "enum": ["counterparty", "user", "agent"] },
        "content_commitment": { "$ref": "#/$defs/hex64" }
      }
    },
    "body_claim": { "$ref": "#/$defs/claim" },
    "body_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "verified"],
      "properties": {
        "source": { "$ref": "#/$defs/ns_token" },
        "verified": { "type": "boolean" },
        "detail_commitment": { "$ref": "#/$defs/hex64" },
        "counterparty_facts": { "$ref": "#/$defs/counterparty_facts" },
        "merchant_email": { "$ref": "#/$defs/merchant_email" },
        "obligation": { "$ref": "#/$defs/obligation" },
        "resolves_obligation": { "$ref": "#/$defs/digest_ref" }
      }
    },
    "obligation": {
      "description": "A commitment tied to a date. A cancel-by kind (trial_conversion, renewal, cancel_window, payment_due) takes effect when its last day to cancel passes: cancel_by. A due kind (deliver_by, perform_by) is something the user owes by a date: due_by. Recorded, never enforced.",
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "oneOf": [
        { "required": ["cancel_by"], "not": { "required": ["due_by"] }, "properties": { "kind": { "enum": ["trial_conversion", "renewal", "cancel_window", "payment_due"] } } },
        { "required": ["due_by"], "not": { "required": ["cancel_by"] }, "properties": { "kind": { "enum": ["deliver_by", "perform_by"] } } }
      ],
      "properties": {
        "kind": { "enum": ["trial_conversion", "renewal", "cancel_window", "payment_due", "deliver_by", "perform_by"] },
        "cancel_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "due_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "takes_effect": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "amount_minor": { "$ref": "#/$defs/safe_uint" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "period": { "enum": ["week", "month", "year", "once"] },
        "terms_commitment": { "$ref": "#/$defs/hex64" }
      }
    },
    "merchant_email": {
      "description": "A merchant's own DKIM-signed email, sealed raw on the device. The record carries only digests, the DKIM result against key records captured at seal time, and amounts parsed from the email by heuristics.",
      "type": "object", "additionalProperties": false,
      "required": ["message_digest", "key_records_digest", "key_source", "dkim", "merchant_signed", "dmarc_policy", "parsed"],
      "properties": {
        "message_digest": { "$ref": "#/$defs/hex64" },
        "key_records_digest": { "$ref": "#/$defs/hex64" },
        "key_source": { "enum": ["dns", "supplied"] },
        "dkim": { "enum": ["pass", "fail", "none"] },
        "merchant_signed": { "type": "boolean" },
        "dmarc_policy": { "enum": ["reject", "quarantine", "none", "absent", "not_captured"] },
        "dmarc_record_digest": { "$ref": "#/$defs/hex64" },
        "dmarc_source": { "enum": ["dns", "supplied"] },
        "signer_matches_baseline": { "type": "boolean" },
        "parsed": {
          "type": "object", "additionalProperties": false, "required": ["method"],
          "properties": {
            "method": { "const": "heuristic" },
            "total_minor": { "$ref": "#/$defs/safe_uint" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "order_id_commitment": { "$ref": "#/$defs/hex64" },
            "cancel_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "sent_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
            "item_count": { "$ref": "#/$defs/safe_uint" },
            "kind": { "enum": ["confirmation", "cancellation"] }
          }
        }
      }
    },
    "body_detail_change": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "changed"],
      "properties": {
        "source": { "$ref": "#/$defs/ns_token" },
        "changed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": {
          "enum": ["payee", "name", "domain", "phone", "email", "relay_address", "profile_id", "item", "quantity", "price", "deposit", "currency", "when", "place", "conditions", "rail", "refundable"] } },
        "terms": { "$ref": "#/$defs/terms" },
        "recourse": { "$ref": "#/$defs/recourse" }
      }
    },
    "body_check": {
      "type": "object", "additionalProperties": false,
      "required": ["action"],
      "dependentRequired": { "action_class": ["taxonomy_version"], "taxonomy_version": ["action_class"], "spend_authorized_minor": ["authorized_max_minor", "spend_minor"] },
      "properties": {
        "action": { "$ref": "#/$defs/point_of_no_return" },
        "action_class": { "$ref": "#/$defs/action_class" },
        "taxonomy_version": { "$ref": "#/$defs/taxonomy_version" },
        "spend_minor": { "description": "The amount a spend cap evaluates: what the action pays out. 0 on every cancel. Sealed with action_class.", "$ref": "#/$defs/safe_uint" },
        "authorized_max_minor": { "description": "On a pay: the most the counterparty may take under the payment's authorization (a card hold, a pre-authorization with a buffer settled later), at least amount_minor, which stays the expected charge. A limit binds it.", "$ref": "#/$defs/safe_uint" },
        "spend_authorized_minor": { "description": "The authorized maximum beside spend_minor: what a per-action spend cap reads. Sealed with action_class and authorized_max_minor.", "$ref": "#/$defs/safe_uint" },
        "direction": { "description": "On a cancel with an amount: in. Sealed with action_class.", "enum": ["in"] },
        "fee_minor": { "description": "On a cancel only: a fee the cancellation costs, recorded as its own amount and never the amount a spend cap evaluates.", "$ref": "#/$defs/safe_uint" },
        "cancelled_amount_minor": { "description": "On a cancel only: the amount the cancel was about when it returns no sealed payment (part of one, or one it matches none of). Neither money moved nor spend; sealed with direction in.", "$ref": "#/$defs/safe_uint" },
        "amount_minor": { "$ref": "#/$defs/safe_uint" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "seen_item": { "type": "boolean" },
        "disclosing": { "description": "For a share: the classes of the user's data about to be given.", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/disclosure_class" } },
        "disclosing_to": { "description": "For a share: who receives it, the counterparty or someone else. An approval covers a telling only to that party.", "enum": ["counterparty", "other"] },
        "terms": { "$ref": "#/$defs/terms" },
        "recipient_role": {"enum": ["fulfilling_merchant", "third_party", "self"], "description": "Who receives a share, by role: fulfilling_merchant (the deal's counterparty), third_party (anyone else) or self. A role, never a name. Absent when not a share or not known."},
        "channel": {"$ref": "#/$defs/channel", "description": "The channel kind in use at this check (x-deal-v0's channel set): the latest sealed message's, else first contact's. A kind, never an address."},
        "first_contact_channel": {"$ref": "#/$defs/channel", "description": "The channel kind the relationship started on (the baseline's channel). A kind, never an address."},
        "material_fields_changed": {"type": "integer", "minimum": 0, "maximum": 11, "description": "How many of the material fields (the list material_fields_basis names: terms.item, terms.quantity, terms.price_minor, terms.deposit_minor, terms.currency, terms.when, terms.place, terms.conditions, recourse.rail, recourse.refundable, who.payee) the proposal changes from what was agreed. A key counts when present on one side and absent on the other, or present on both with unequal JCS values; terms.conditions counts as one key."},
        "material_fields_basis": {"$ref": "#/$defs/hex64", "description": "Lowercase hex SHA-256 of the JCS bytes of the material field list, in order."},
        "offer_fields_changed": {"type": "integer", "minimum": 0, "maximum": 6, "description": "How many of the offer fields (terms.item, terms.quantity, terms.price_minor, terms.deposit_minor, terms.conditions, recourse.refundable) that the user's own words state (intent.asked) the proposal does not match: absent, or present with an unequal JCS value. A key their words do not state is not counted. Absent when their words state none of these keys."},
        "offer_fields_basis": {"$ref": "#/$defs/hex64", "description": "Lowercase hex SHA-256 of the JCS bytes of the offer field list, in order."},
        "upfront_amount_minor": { "$ref": "#/$defs/safe_uint", "description": "What the action asks for up front, in minor units: the deposit the check's own terms state (terms.deposit_minor), and only that. Absent when the check states no deposit; never inferred." },
        "recourse": { "$ref": "#/$defs/recourse" },
        "description_commitment": { "$ref": "#/$defs/hex64" },
        "pack_id": { "$ref": "#/$defs/pack_id" },
        "pack_digest": { "$ref": "#/$defs/hex64" }
      }
    },
    "body_verdict": {
      "type": "object", "additionalProperties": false,
      "required": ["result", "differences", "options"],
      "properties": {
        "result": { "enum": ["pass", "pause", "deny"], "description": "deny: the profile's rules (its pinned external checker) did not allow the action; a deny offers no way to proceed." },
        "materiality": { "$ref": "#/$defs/materiality_ref", "description": "The materiality predicate that decided which of the agent's own picks pause. Absent on verdicts sealed before it was recorded." },
        "rules": {
          "description": "What the profile's rules said: evaluated by its pinned external checker (the ruleset it reported, by id and definition digest, its verdict and every finding, and the history it was given), not evaluated (a configured checker that could not answer, and why), or not configured. Absent on verdicts sealed before it was recorded.",
          "type": "object", "additionalProperties": false, "required": ["status"],
          "properties": {
            "status": { "enum": ["evaluated", "not_evaluated", "not_configured"] },
            "cause": { "enum": ["checker_unavailable", "checker_changed", "refused", "timeout", "unreadable", "ruleset_changed"], "description": "Why a configured checker's answer was not evaluated. The checker's own words are not sealed in the clear; the card that showed them is committed to." },
            "ruleset_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "definition_digest": { "$ref": "#/$defs/hex64" },
            "checker_sha256": { "$ref": "#/$defs/hex64" },
            "verdict": { "enum": ["allow", "deny", "escalate", "not_evaluable"] },
            "tier": { "enum": ["recomputed", "judged", "not_stated"], "description": "How the checker said it reached its verdict (Result v0's Tier), as reported; not_stated when it did not say, which reads as judged, never recomputed. Recorded only: it changes nothing about the verdict." },
            "grade": { "enum": ["self-attested", "witnessed", "countersigned"], "description": "The grade of the evidence behind the checker's result (Result v0's Grade), as reported; absent when it stated none. Recorded only." },
            "history": {
              "description": "The history the checker was given beside the record: how many earlier acts, over how many days, and whether that is every one of them.",
              "type": "object", "additionalProperties": false, "required": ["days", "acts", "complete"],
              "properties": {
                "days": { "type": "integer", "minimum": 1 },
                "acts": { "type": "integer", "minimum": 0 },
                "complete": { "type": "boolean" }
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object", "required": ["id", "verdict"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "check": { "type": "string", "maxLength": 200 },
                  "verdict": { "enum": ["pass", "fail", "not_applicable", "not_evaluable"] },
                  "limit": { "$ref": "#/$defs/rules_scalar" },
                  "value": { "$ref": "#/$defs/rules_scalar" }
                },
                "additionalProperties": false
              }
            }
          },
          "allOf": [
            { "if": { "properties": { "status": { "const": "evaluated" } } }, "then": { "required": ["ruleset_id", "definition_digest", "checker_sha256", "verdict", "findings", "history"] } },
            { "if": { "properties": { "status": { "const": "not_evaluated" } } }, "then": { "required": ["cause"] } }
          ]
        },
        "pack_id": { "$ref": "#/$defs/pack_id" },
        "differences": { "type": "array", "items": { "$ref": "#/$defs/difference" } },
        "unverified": { "type": "array", "items": { "$ref": "#/$defs/short_text" } },
        "unverified_claims": { "description": "The claims the check found unverified, by reference: the record each was sealed in, and for a baseline claim its index. Their words are commitments in those records.", "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["claim"], "properties": { "claim": { "$ref": "#/$defs/digest_ref" }, "index": { "type": "integer", "minimum": 0 } } } },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "options": { "type": "array", "uniqueItems": true, "items": { "enum": ["hold", "verify_contact", "proceed"] } },
        "card_commitment": { "$ref": "#/$defs/hex64" },
        "judge": {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": { "enum": ["rules", "remote"] },
            "status": { "$ref": "#/$defs/token" },
            "response_digest": { "$ref": "#/$defs/hex64" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "result": { "const": "pause" } } },
          "then": { "properties": { "differences": { "minItems": 1 }, "options": { "minItems": 1 } } } },
        { "if": { "properties": { "result": { "const": "pass" } } },
          "then": { "properties": { "options": { "maxItems": 0 } } } },
        { "if": { "properties": { "result": { "const": "deny" } } },
          "then": { "properties": { "differences": { "minItems": 1 }, "options": { "items": { "const": "hold" } }, "rules": { "required": ["status"] } }, "required": ["rules"] } }
      ]
    },
    "rules_scalar": {
      "oneOf": [
        { "type": "number" },
        { "type": "string", "maxLength": 64, "pattern": "^[^\\r\\n]*$" }
      ]
    },
    "limit_set": {
      "description": "A version of the user's limits. allowed absent = no restriction; present and empty = nothing is allowed yet.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_total_minor": { "type": "integer", "minimum": 0 },
        "allowed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "body_approval": {
      "type": "object", "additionalProperties": false,
      "required": ["choice", "proceed", "approver"],
      "properties": {
        "choice": { "enum": ["hold", "verify_contact", "proceed", "confirm_limits"] },
        "proceed": { "type": "boolean" },
        "approver": { "enum": ["user", "standing_intent", "agent_card"] },
        "said_commitment": { "$ref": "#/$defs/hex64" },
        "card_commitment": {
          "description": "The card the answer was given on, committed under the answered verdict's card nonce: equal to the verdict's card_commitment exactly when the card shown is the card checked.",
          "$ref": "#/$defs/hex64" },
        "limits": {
          "description": "On confirm_limits only: the user's limits in force before this answer and the new version it puts in force. The intent it approves is the proposal.",
          "type": "object", "additionalProperties": false, "required": ["previous", "new"],
          "properties": { "previous": { "$ref": "#/$defs/limit_set" }, "new": { "$ref": "#/$defs/limit_set" } }
        }
      },
      "allOf": [
        { "if": { "properties": { "choice": { "const": "proceed" } } },
          "then": { "properties": { "proceed": { "const": true } } } },
        { "if": { "properties": { "choice": { "enum": ["hold", "verify_contact"] } } },
          "then": { "properties": { "proceed": { "const": false } } } },
        { "if": { "properties": { "choice": { "const": "confirm_limits" } } },
          "then": { "required": ["limits"], "properties": { "approver": { "const": "user" } } },
          "else": { "not": { "required": ["limits"] } } },
        { "if": { "properties": { "approver": { "const": "user" } } },
          "then": { "required": ["said_commitment"] },
          "else": { "not": { "required": ["said_commitment"] } } },
        { "if": { "properties": { "approver": { "const": "standing_intent" } } },
          "then": { "properties": { "choice": { "const": "proceed" } }, "not": { "required": ["card_commitment"] } } },
        { "if": { "properties": { "choice": { "const": "confirm_limits" } } },
          "then": { "not": { "required": ["card_commitment"] } } }
      ]
    },
    "body_action": {
      "type": "object", "additionalProperties": false,
      "required": ["action"],
      "dependentRequired": { "action_class": ["taxonomy_version"], "taxonomy_version": ["action_class"] },
      "properties": {
        "action": { "$ref": "#/$defs/point_of_no_return" },
        "action_class": { "$ref": "#/$defs/action_class" },
        "taxonomy_version": { "$ref": "#/$defs/taxonomy_version" },
        "spend_minor": { "description": "The amount a spend cap evaluates: what the action pays out. 0 on every cancel. Sealed with action_class.", "$ref": "#/$defs/safe_uint" },
        "fee_minor": { "description": "On a cancel only: a fee the cancellation costs, recorded as its own amount and never the amount a spend cap evaluates.", "$ref": "#/$defs/safe_uint" },
        "cancelled_amount_minor": { "description": "On a cancel only: the amount the cancel was about when it returns no sealed payment (part of one, or one it matches none of). Neither money moved nor spend; sealed with direction in.", "$ref": "#/$defs/safe_uint" },
        "amount_minor": { "$ref": "#/$defs/safe_uint" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "rail": { "$ref": "#/$defs/ns_token" },
        "direction": { "description": "Which way the amount moved: out (paid by the user) or in (back to the user, from the action it reverses). Absent on records sealed before it was recorded.", "enum": ["out", "in"] },
        "reference_commitment": { "$ref": "#/$defs/hex64" },
        "description_commitment": { "$ref": "#/$defs/hex64" }
      }
    },
    "body_outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "outcome", "differences"],
      "properties": {
        "status": { "enum": ["received", "not_received", "pending", "unchecked_action", "reverted", "not_selected"] },
        "outcome": { "$ref": "#/$defs/outcome_value" },
        "delivered": { "$ref": "#/$defs/terms" },
        "differences": { "type": "array", "items": { "$ref": "#/$defs/difference" } },
        "unchecked": { "$ref": "#/$defs/body_action" },
        "note_commitment": { "$ref": "#/$defs/hex64" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "pending" } } }, "then": { "properties": { "outcome": { "const": "open" } } } },
        { "if": { "properties": { "status": { "const": "not_selected" } }, "required": ["status"] }, "then": { "properties": { "outcome": { "const": "not_selected" }, "differences": { "maxItems": 0 } } } },
        { "if": { "properties": { "outcome": { "const": "not_selected" } }, "required": ["outcome"] }, "then": { "properties": { "status": { "const": "not_selected" } } } },
        { "if": { "properties": { "status": { "enum": ["not_received", "unchecked_action"] } } }, "then": { "properties": { "outcome": { "const": "mismatch" }, "differences": { "minItems": 1 } } } },
        { "if": { "properties": { "status": { "const": "unchecked_action" } } }, "then": { "required": ["unchecked"] }, "else": { "not": { "required": ["unchecked"] } } },
        { "if": { "properties": { "outcome": { "const": "completed" } } }, "then": { "properties": { "differences": { "maxItems": 0 }, "status": { "const": "received" } } } },
        { "if": { "properties": { "status": { "const": "received" } }, "required": ["status"] },
          "then": { "if": { "properties": { "differences": { "minItems": 1 } } }, "then": { "properties": { "outcome": { "const": "mismatch" } } }, "else": { "properties": { "outcome": { "const": "completed" } } } } }
      ]
    },
    "disclosure_class": {
      "description": "The kind of thing told about the user. Contact classes are covered by a share_contact check; credential classes by share_credentials.",
      "enum": ["name", "phone", "email", "home_address", "address", "pickup_location", "other_contact", "credential", "verification_code", "payment_card", "id_document"]
    },
    "body_disclosure": {
      "description": "Something the agent told someone about the user: the class of each field and a commitment to its value, never the value. authority is approval (refs carries exactly one authorized_by) or none (rule says why).",
      "type": "object",
      "additionalProperties": false,
      "required": ["to", "fields", "authority"],
      "dependentRequired": { "action_class": ["taxonomy_version"], "taxonomy_version": ["action_class"] },
      "properties": {
        "to": { "enum": ["counterparty", "other"] },
        "action_class": { "$ref": "#/$defs/action_class" },
        "taxonomy_version": { "$ref": "#/$defs/taxonomy_version" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "value_commitment"],
            "properties": {
              "class": { "$ref": "#/$defs/disclosure_class" },
              "value_commitment": { "$ref": "#/$defs/hex64" }
            }
          }
        },
        "authority": { "enum": ["approval", "none"] },
        "rule": { "$ref": "#/$defs/token" }
      },
      "allOf": [
        { "if": { "properties": { "authority": { "const": "none" } } }, "then": { "required": ["rule"] }, "else": { "not": { "required": ["rule"] } } }
      ]
    },
    "body_close": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "unchecked_actions"],
      "properties": {
        "outcome": { "$ref": "#/$defs/outcome_value" },
        "unchecked_actions": { "$ref": "#/$defs/safe_uint" },
        "differences": { "type": "array", "items": { "$ref": "#/$defs/difference" } },
        "carried_obligations": {
          "description": "Obligations still open at the close, carried by it, each with its cancel-by date or its due date: they stay open after the close until a later record that confirms the close resolves them, or the date passes.",
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["obligation"],
            "oneOf": [
              { "required": ["cancel_by"], "not": { "required": ["due_by"] } },
              { "required": ["due_by"], "not": { "required": ["cancel_by"] } }
            ],
            "properties": {
              "obligation": { "$ref": "#/$defs/digest_ref" },
              "cancel_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "due_by": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
            }
          }
        }
      }
    }
  }
}
