{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentactioncapsule.org/records/action-outcome-v0.schema.json",
  "title": "action-outcome/v0",
  "description": "What was observed about an action, or an action attempted without authority (status unchecked_action: attempted is what was done, findings say why it was not covered). not_selected (status and outcome alike, with no findings): the other side was not chosen, and nothing was done on the deal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "canonicalization",
    "chain_id",
    "seq",
    "at",
    "prev",
    "chain_root",
    "body"
  ],
  "properties": {
    "type": {
      "const": "action-outcome/v0"
    },
    "canonicalization": {
      "const": "jcs"
    },
    "chain_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,15}-[0-9a-f]{16,64}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "at": {
      "$ref": "record-common-v0.schema.json#/$defs/when"
    },
    "prev": {
      "$ref": "record-common-v0.schema.json#/$defs/ref"
    },
    "chain_root": {
      "$ref": "record-common-v0.schema.json#/$defs/ref"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "record-common-v0.schema.json#/$defs/rel_ref"
      }
    },
    "producer": {
      "$ref": "record-common-v0.schema.json#/$defs/producer"
    },
    "commit_alg": {
      "$ref": "record-common-v0.schema.json#/$defs/commit_alg"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "outcome",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "received",
            "not_received",
            "pending",
            "unchecked_action",
            "reverted",
            "not_selected"
          ]
        },
        "outcome": {
          "enum": [
            "completed",
            "mismatch",
            "open",
            "not_selected"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "record-common-v0.schema.json#/$defs/finding"
          }
        },
        "attempted": {
          "allOf": [
            {
              "$ref": "record-common-v0.schema.json#/$defs/action_body"
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "evaluation_ref"
                    ]
                  },
                  {
                    "required": [
                      "authority_basis"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "delivered": {
          "type": "object"
        },
        "note_commitment": {
          "$ref": "record-common-v0.schema.json#/$defs/hex64"
        },
        "actor": {
          "description": "Whose decision ended the deal (user, agent or platform), as the x-deal-v0 outcome records it; with reason, on an outcome a close seals. Absent on records sealed before.",
          "enum": [
            "user",
            "agent",
            "platform"
          ]
        },
        "reason": {
          "description": "Why the deal ended, from the x-deal-v0 close_reason set; never free text.",
          "enum": [
            "completed",
            "delivered_mismatch",
            "awaiting_delivery",
            "not_selected",
            "user_closed",
            "agent_could_not_complete",
            "merchant_rejected",
            "payment_failed",
            "cancelled_in_window",
            "not_delivered",
            "other"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unchecked_action"
              }
            }
          },
          "then": {
            "required": [
              "attempted"
            ],
            "properties": {
              "outcome": {
                "const": "mismatch"
              },
              "findings": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "attempted"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "open"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_selected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "not_selected"
              },
              "findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "not_selected"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "not_selected"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "findings": {
                "maxItems": 0
              },
              "status": {
                "const": "received"
              }
            }
          }
        }
      ],
      "dependentRequired": {
        "actor": [
          "reason"
        ],
        "reason": [
          "actor"
        ]
      }
    }
  }
}
