{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentactioncapsule.org/records/task-authority-v0.schema.json",
  "title": "task-authority/v0",
  "description": "The user's task authority: what they asked for and the limits they set (max_total_minor; allowed: absent = no restriction, present and empty = nothing allowed yet), with their words by commitment. A later version names the one it replaces (previous_ref) and carries the user's words confirming it (said_commitment); it approves the proposal it confirms.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "canonicalization",
    "chain_id",
    "seq",
    "at",
    "prev",
    "chain_root",
    "body"
  ],
  "properties": {
    "type": {
      "const": "task-authority/v0"
    },
    "canonicalization": {
      "const": "jcs"
    },
    "chain_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,15}-[0-9a-f]{16,64}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "at": {
      "$ref": "record-common-v0.schema.json#/$defs/when"
    },
    "prev": {
      "$ref": "record-common-v0.schema.json#/$defs/ref"
    },
    "chain_root": {
      "$ref": "record-common-v0.schema.json#/$defs/ref"
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "record-common-v0.schema.json#/$defs/rel_ref"
      }
    },
    "producer": {
      "$ref": "record-common-v0.schema.json#/$defs/producer"
    },
    "commit_alg": {
      "$ref": "record-common-v0.schema.json#/$defs/commit_alg"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verbatim_commitment"
      ],
      "properties": {
        "verbatim_commitment": {
          "$ref": "record-common-v0.schema.json#/$defs/hex64"
        },
        "max_total_minor": {
          "$ref": "record-common-v0.schema.json#/$defs/uint"
        },
        "bounds_commitment": {
          "description": "The salted commitment to the commercial-bounds/v0 document holding the lowest total the user will take. The floor itself is never in this record, so the task authority can be shared whole.",
          "$ref": "record-common-v0.schema.json#/$defs/hex64"
        },
        "allowed": {
          "type": "array",
          "items": {
            "$ref": "record-common-v0.schema.json#/$defs/action"
          },
          "uniqueItems": true
        },
        "outcome_id": {
          "description": "The plan's outcome, a fixed id per deal type (part of the plan's own digest, so never changed). Present with allowed_actions.",
          "enum": [
            "capsulectl.deal.purchase/1.0.0",
            "capsulectl.deal.rental/1.0.0",
            "capsulectl.deal.booking/1.0.0",
            "capsulectl.deal.service/1.0.0"
          ]
        },
        "allowed_actions": {
          "description": "The same actions as allowed, in the plan shape a rules checker reads (allowed_actions). Absent, like allowed, when nothing restricts the task.",
          "type": "array",
          "items": {
            "$ref": "record-common-v0.schema.json#/$defs/action"
          },
          "uniqueItems": true
        },
        "preconditions": {
          "description": "The plan's preconditions: each an action and the step it must cite. capsulectl states none.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "citing"
            ],
            "properties": {
              "action": {
                "$ref": "record-common-v0.schema.json#/$defs/action"
              },
              "citing": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "asked": {
          "type": "object"
        },
        "previous_ref": {
          "$ref": "record-common-v0.schema.json#/$defs/ref"
        },
        "said_commitment": {
          "$ref": "record-common-v0.schema.json#/$defs/hex64"
        },
        "sale_authority_commitment": {
          "description": "On a buyer's thread of a sale: the digest of the sale's one task authority (in the sale's own log), committed under this step's own nonce, so the threads of one sale carry no equal value. The opening is in the user's own copy and an adjudicator's.",
          "$ref": "record-common-v0.schema.json#/$defs/hex64"
        }
      },
      "dependentRequired": {
        "previous_ref": [
          "said_commitment"
        ],
        "said_commitment": [
          "previous_ref"
        ]
      }
    }
  }
}
