{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentactioncapsule.org/records/record-common-v0.schema.json",
  "title": "Typed action records: shared definitions",
  "description": "The header every typed action record carries, and the definitions the types share. A typed record is {type, canonicalization, chain_id, seq, at, prev, chain_root, refs?, producer?, body}; its digest is SHA-256 over the RFC 8785 (JCS) bytes of the whole record. Records of one chain share a chain_id and are hash-linked by prev; chain_root is the chain's first record.",
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "action_class": {
      "description": "The action's class in the action taxonomy that taxonomy_version names.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
    },
    "taxonomy_version": {
      "description": "The version of the action taxonomy action_class is drawn from.",
      "type": "string",
      "pattern": "^[1-9][0-9]{0,3}$"
    },
    "ns_token": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9_]{0,63}|[a-z0-9-]+(\\.[a-z0-9-]+)+\\.[a-z][a-z0-9_]{0,63})$"
    },
    "when": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "uint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "caller_name": {
      "description": "A name the caller gives; capsulectl chooses none.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "digest_alg",
        "digest"
      ],
      "properties": {
        "type": {
          "const": "record"
        },
        "digest_alg": {
          "const": "SHA-256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "rel_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rel",
        "type",
        "digest_alg",
        "digest"
      ],
      "properties": {
        "rel": {
          "enum": [
            "checks",
            "approves",
            "authorized_by",
            "observes",
            "reverses",
            "source"
          ]
        },
        "type": {
          "const": "record"
        },
        "digest_alg": {
          "const": "SHA-256"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "commit_alg": {
      "description": "The construction of this record's *_commitment values: SHA-256 over the RFC 8785 (JCS) bytes of {\"nonce\": N, \"text\": T}, N a fresh random 256-bit nonce (64 lowercase hex) per commitment, no key. Recomputable only by a holder of the opening (N and T). Absent on records sealed before it was declared.",
      "const": "sha256-jcs-nonce256"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "commit"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "counterparty": {
      "description": "Counterparty identifiers as keyed fingerprints, never raw values.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fp_alg",
        "ids"
      ],
      "properties": {
        "fp_alg": {
          "const": "hmac-sha256-chain-key"
        },
        "ids": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "payee",
              "name",
              "domain",
              "phone",
              "email",
              "relay_address",
              "profile_id"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "action": {
      "enum": [
        "pay",
        "sign",
        "commit",
        "cancel",
        "share_contact",
        "share_credentials"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "rule"
      ],
      "properties": {
        "question": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "rule": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]{0,63}|[a-z0-9-]+(\\.[a-z0-9-]+)+\\.[a-z][a-z0-9_]{0,63})$"
        },
        "field": {
          "description": "The attribute, as the x-deal-v0 difference names it (e.g. payee, conditions.size).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)?$"
        }
      }
    },
    "authority_entry": {
      "description": "One authority layer relied on: task_authority -> a task-authority/v0; user_approval, platform_approval, one_shot_override -> an action-approval/v0 of that authority. scope mismatch: a platform approval that stated another amount.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "enum": [
            "task_authority",
            "user_approval",
            "platform_approval",
            "one_shot_override"
          ]
        },
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "scope": {
          "const": "mismatch"
        }
      },
      "if": {
        "properties": {
          "type": {
            "not": {
              "const": "platform_approval"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "scope"
          ]
        }
      }
    },
    "authority_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/authority_entry"
      }
    },
    "materiality": {
      "description": "The materiality an evaluation ran under: predicate (a materiality-predicate/v0 document, by materiality_digest), or none_fail_safe (none was configured: every pick the agent made alone pauses; materiality_digest is null).",
      "enum": [
        "predicate",
        "none_fail_safe"
      ]
    },
    "materiality_digest": {
      "description": "SHA-256 of the JCS bytes of the materiality predicate evaluated; null when none was configured.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "materiality_pair": {
      "if": {
        "properties": {
          "materiality": {
            "const": "predicate"
          }
        },
        "required": [
          "materiality"
        ]
      },
      "then": {
        "properties": {
          "materiality_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "materiality_digest": {
            "type": "null"
          }
        }
      }
    },
    "disclosed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "fields"
      ],
      "properties": {
        "to": {
          "enum": [
            "counterparty",
            "other"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "class",
              "value_commitment"
            ],
            "properties": {
              "class": {
                "enum": [
                  "name",
                  "phone",
                  "email",
                  "home_address",
                  "address",
                  "pickup_location",
                  "other_contact",
                  "credential",
                  "verification_code",
                  "payment_card",
                  "id_document"
                ]
              },
              "value_commitment": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "action_body": {
      "type": "object",
      "required": [
        "action"
      ],
      "dependentRequired": {
        "action_class": [
          "taxonomy_version"
        ],
        "taxonomy_version": [
          "action_class"
        ]
      },
      "properties": {
        "action": {
          "$ref": "#/$defs/action"
        },
        "action_class": {
          "$ref": "#/$defs/action_class"
        },
        "taxonomy_version": {
          "$ref": "#/$defs/taxonomy_version"
        },
        "spend_minor": {
          "description": "The amount a spend cap evaluates: what the action pays out. 0 on every cancel.",
          "$ref": "#/$defs/uint"
        },
        "fee_minor": {
          "description": "On a cancel only: a fee the cancellation costs, never the amount a spend cap evaluates.",
          "$ref": "#/$defs/uint"
        },
        "cancelled_amount_minor": {
          "description": "On a cancel only: the amount the cancel was about when it returns no sealed payment. Neither money moved nor spend.",
          "$ref": "#/$defs/uint"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "rail": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]{0,63}|[a-z0-9-]+(\\.[a-z0-9-]+)+\\.[a-z][a-z0-9_]{0,63})$"
        },
        "direction": {
          "enum": [
            "out",
            "in"
          ]
        },
        "reference_commitment": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "description_commitment": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "disclosed": {
          "$ref": "#/$defs/disclosed"
        },
        "channel": {
          "type": "string",
          "maxLength": 64
        },
        "counterparty": {
          "$ref": "#/$defs/counterparty"
        }
      }
    }
  }
}
