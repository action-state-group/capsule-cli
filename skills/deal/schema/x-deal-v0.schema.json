{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "x-deal-v0.schema.json",
  "title": "x-deal-v0 deal step",
  "description": "One sealed step of a deal, as `capsulectl deal` seals it: the payload of one Capsule, bound by its agent_input_digest (JCS, RFC 8785). A private x- profile that ships with the deal skill; it is not registered anywhere. Money is integer minor units; no floats.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "deal_id", "n", "kind", "at"],
  "properties": {
    "spec": { "const": "x-deal-v0" },
    "deal_id": { "type": "string", "pattern": "^deal-[0-9a-f]{16}$" },
    "n": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["open", "message", "claim", "evidence", "change", "snapshot", "check", "approval", "act", "close"] },
    "prev": { "$ref": "#/$defs/capsule_id", "description": "The previous step's capsule_id; absent only on step 1." },
    "at": { "type": "string", "format": "date-time" },
    "open": { "$ref": "#/$defs/open" },
    "message": { "$ref": "#/$defs/message" },
    "claim": { "$ref": "#/$defs/claim" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "change": { "$ref": "#/$defs/change" },
    "snapshot": { "$ref": "#/$defs/snapshot" },
    "check": { "$ref": "#/$defs/check" },
    "approval": { "$ref": "#/$defs/approval" },
    "act": { "$ref": "#/$defs/act" },
    "close": { "$ref": "#/$defs/close" }
  },
  "allOf": [
    { "if": { "properties": { "n": { "const": 1 } } }, "then": { "properties": { "kind": { "const": "open" } }, "not": { "required": ["prev"] } }, "else": { "required": ["prev"] } },
    { "if": { "properties": { "kind": { "const": "open" } } }, "then": { "required": ["open"] } },
    { "if": { "properties": { "kind": { "const": "message" } } }, "then": { "required": ["message"] } },
    { "if": { "properties": { "kind": { "const": "claim" } } }, "then": { "required": ["claim"] } },
    { "if": { "properties": { "kind": { "const": "evidence" } } }, "then": { "required": ["evidence"] } },
    { "if": { "properties": { "kind": { "const": "change" } } }, "then": { "required": ["change"] } },
    { "if": { "properties": { "kind": { "const": "snapshot" } } }, "then": { "required": ["snapshot"] } },
    { "if": { "properties": { "kind": { "const": "check" } } }, "then": { "required": ["check"] } },
    { "if": { "properties": { "kind": { "const": "approval" } } }, "then": { "required": ["approval"] } },
    { "if": { "properties": { "kind": { "const": "act" } } }, "then": { "required": ["act"] } },
    { "if": { "properties": { "kind": { "const": "close" } } }, "then": { "required": ["close"] } },
    {
      "maxProperties": 7,
      "description": "Exactly one body: the five envelope members, prev, and the body named by kind."
    }
  ],
  "$defs": {
    "capsule_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "money": { "type": "integer" },
    "action": { "enum": ["pay", "commit", "sign", "cancel", "share_contact", "share_credentials"] },
    "who": {
      "type": "object",
      "additionalProperties": false,
      "description": "Counterparty identifiers as seen. Each one sealed at first contact is compared on every check.",
      "properties": {
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "payee": { "type": "string" },
        "relay_address": { "type": "string" },
        "profile_id": { "type": "string" },
        "domain_age_days": { "type": "integer", "minimum": 0 }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": { "type": "string" },
        "quantity": { "type": "integer" },
        "price_minor": { "$ref": "#/$defs/money" },
        "deposit_minor": { "$ref": "#/$defs/money" },
        "currency": { "type": "string" },
        "when": { "type": "string" },
        "place": { "type": "string" },
        "conditions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" }
      }
    },
    "recourse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rail": { "type": "string" },
        "refundable": { "type": "boolean" }
      }
    },
    "open": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "intent", "who", "terms", "recourse"],
      "properties": {
        "type": { "enum": ["purchase", "rental", "booking", "service"] },
        "demo": { "type": "boolean" },
        "channel": { "type": "string" },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verbatim"],
          "properties": {
            "verbatim": { "type": "string", "minLength": 1, "description": "The user's exact words." },
            "asked": { "$ref": "#/$defs/terms" },
            "max_total_minor": { "$ref": "#/$defs/money" },
            "allowed": { "type": "array", "items": { "$ref": "#/$defs/action" } }
          }
        },
        "who": { "$ref": "#/$defs/who" },
        "terms": { "$ref": "#/$defs/terms" },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "recourse": { "$ref": "#/$defs/recourse", "required": ["rail", "refundable"] }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "text"],
      "properties": {
        "from": { "enum": ["counterparty", "user", "agent"] },
        "channel": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "who": { "$ref": "#/$defs/who" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["about", "source"],
      "properties": {
        "about": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "detail": { "type": "string" },
        "who": { "$ref": "#/$defs/who" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "anyOf": [{ "required": ["who"] }, { "required": ["terms"] }, { "required": ["recourse"] }],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "who": { "$ref": "#/$defs/who" },
        "terms": { "$ref": "#/$defs/terms" },
        "recourse": { "$ref": "#/$defs/recourse" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "$ref": "#/$defs/action" },
        "description": { "type": "string" },
        "amount_minor": { "$ref": "#/$defs/money" },
        "seen_item": { "type": "boolean" },
        "who": { "$ref": "#/$defs/who" },
        "terms": { "$ref": "#/$defs/terms" },
        "recourse": { "$ref": "#/$defs/recourse" }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "rule", "text"],
      "properties": {
        "question": { "enum": ["asked", "who", "terms", "recourse", "safety", "remote", "delivered"] },
        "rule": { "type": "string" },
        "field": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "snapshot", "verdict", "differences", "unverified", "notes", "card", "options", "remote"],
      "properties": {
        "action": { "$ref": "#/$defs/action" },
        "snapshot": { "$ref": "#/$defs/capsule_id" },
        "verdict": { "enum": ["pass", "pause"] },
        "differences": { "type": "array", "items": { "$ref": "#/$defs/difference" } },
        "unverified": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } },
        "card": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": { "id": { "enum": ["hold", "verify_contact", "proceed"] }, "label": { "type": "string" } }
          }
        },
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["not_configured", "unavailable", "used"] },
            "response_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "differences": { "type": "array", "items": { "$ref": "#/$defs/difference" } }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "choice", "proceed"],
      "properties": {
        "check": { "$ref": "#/$defs/capsule_id" },
        "choice": { "enum": ["hold", "verify_contact", "proceed"] },
        "said": { "type": "string" },
        "proceed": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "unchecked"],
      "properties": {
        "action": { "$ref": "#/$defs/action" },
        "description": { "type": "string" },
        "amount_minor": { "$ref": "#/$defs/money" },
        "currency": { "type": "string" },
        "payee": { "type": "string" },
        "rail": { "type": "string" },
        "reference": { "type": "string" },
        "authorized_by": { "$ref": "#/$defs/capsule_id" },
        "unchecked": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "close": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outcome", "differences", "unchecked_actions"],
      "properties": {
        "status": { "enum": ["received", "pending", "not_received"] },
        "delivered": { "$ref": "#/$defs/terms" },
        "note": { "type": "string" },
        "outcome": { "enum": ["completed", "mismatch", "open"] },
        "differences": { "type": "array", "items": { "$ref": "#/$defs/difference" } },
        "unchecked_actions": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
